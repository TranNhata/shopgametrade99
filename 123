-- CONFIG
local ITEM_NAME = "Carrot" -- Item muốn tự nhặt
local CONTAINER_NAME = "Old Sack" -- Túi muốn cất vào

-- Tìm item gần nhất trong workspace.Items
local function findNearestItem(itemName)
	local itemsFolder = workspace:FindFirstChild("Items")
	if not itemsFolder then return nil end

	local closest = nil
	local shortestDist = math.huge

	for _, item in ipairs(itemsFolder:GetChildren()) do
		if item.Name == itemName and item:IsA("Model") then
			local part = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
			if part then
				local dist = (hrp.Position - part.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closest = item
					item.PrimaryPart = part
				end
			end
		end
	end

	return closest
end

-- Teleport tới item
local function teleportToItem(itemModel)
	hrp.CFrame = itemModel.PrimaryPart.CFrame + Vector3.new(0, 2, 0)
end

-- Gửi lệnh nhặt
local function pickupItem(itemModel)
	local event = ReplicatedStorage:WaitForChild("RemoteEvents"):FindFirstChild("RequestPickupItem")
	if event then
		event:FireServer(itemModel)
	else
		warn("Không tìm thấy RemoteEvent: RequestPickupItem")
	end
end

-- Đợi item vào ItemBag
local function waitForItemInBag(itemName, timeout)
	local itemBag = player:WaitForChild("ItemBag")
	local startTime = tick()
	while tick() - startTime < timeout do
		local item = itemBag:FindFirstChild(itemName)
		if item then return item end
		task.wait(0.1)
	end
	return nil
end

-- Gửi lệnh cất vào túi
local function storeInBag(containerName, itemInstance)
	local inventory = player:WaitForChild("Inventory")
	local container = inventory:FindFirstChild(containerName)
	if container and itemInstance then
		local func = ReplicatedStorage:WaitForChild("RemoteEvents"):FindFirstChild("RequestBagStoreItem")
		if func then
			func:InvokeServer(container, itemInstance)
		else
			warn("Không tìm thấy RemoteFunction: RequestBagStoreItem")
		end
	else
		warn("Không tìm thấy container hoặc item")
	end
end

-- Chạy toàn bộ quy trình
local function autoLootAndStore()
	local itemModel = findNearestItem(ITEM_NAME)
	if not itemModel then
		warn("Không tìm thấy " .. ITEM_NAME .. " trong map")
		return
	end

	-- Teleport tới item
	teleportToItem(itemModel)
	task.wait(0.3)

	-- Nhặt item
	pickupItem(itemModel)

	-- Chờ item vào túi
	local itemInBag = waitForItemInBag(ITEM_NAME, 3)
	if itemInBag then
		-- Cất vào túi
		storeInBag(CONTAINER_NAME, itemInBag)
	else
		warn("Không thấy item trong túi sau khi nhặt")
	end
end
