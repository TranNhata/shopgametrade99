-- =========================
-- SETUP
-- =========================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")

local rungg = false
local attackThread = nil

-- =========================
-- HÀM ĐẢM BẢO TOOL ĐANG EQUIP
-- =========================
local function getEquippedTool(toolName)
	local tool = char:FindFirstChild(toolName)
	if tool then return tool end

	tool = player.Inventory:FindFirstChild(toolName)
	if tool then
		tool.Parent = char
		task.wait(0.1)
		return tool
	end
	return nil
end

-- =========================
-- START ATTACK
-- =========================
local function startAttack(targetName)
	if rungg then return end
	rungg = true

	attackThread = task.spawn(function()
		while rungg do
			local target = workspace.Characters:FindFirstChild(targetName)
			if not target then break end

			local tool = getEquippedTool("Old Axe")
			if not tool then
				warn("Chua co Old Axe")
				break
			end

			local args = {
				target,
				tool,
				"2_7382390353",
				hrp.CFrame
			}

			local remote = ReplicatedStorage.RemoteEvents:FindFirstChild("ToolDamageObject")
			if remote then
				-- đa số là RemoteEvent
				remote:FireServer(unpack(args))
			end

			task.wait(0.15)
		end
	end)
end

-- =========================
-- STOP ATTACK
-- =========================
local function stopAttack()
	rungg = false
	if attackThread then
		task.cancel(attackThread)
		attackThread = nil
	end
end

-- =========================
-- GUI NÚT (VÍ DỤ)
-- =========================
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
ScreenGui.Name = "FixedHub"

local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 300, 0, 150)
Frame.Position = UDim2.new(0.5, -150, 0.5, -75)
Frame.BackgroundColor3 = Color3.fromRGB(30,30,30)

local function makeBtn(text, pos, callback)
	local b = Instance.new("TextButton", Frame)
	b.Size = UDim2.new(0, 120, 0, 35)
	b.Position = pos
	b.Text = text
	b.TextColor3 = Color3.new(1,1,1)
	b.BackgroundColor3 = Color3.fromRGB(60,120,200)
	b.MouseButton1Click:Connect(callback)
end

-- =========================
-- BUTTONS
-- =========================
makeBtn("OE Bunny", UDim2.new(0, 20, 0, 20), function()
	startAttack("Bunny")
end)

makeBtn("OE Wolf", UDim2.new(0, 160, 0, 20), function()
	startAttack("Wolf")
end)

makeBtn("OFF", UDim2.new(0, 90, 0, 80), function()
	stopAttack()
end)

-- =========================
-- CLEANUP KHI RESPAWN
-- =========================
player.CharacterAdded:Connect(function(c)
	char = c
	hrp = c:WaitForChild("HumanoidRootPart")
	stopAttack()
end)
